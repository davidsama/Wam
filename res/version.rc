// version.rc - the version resource wam.exe carries (Properties > Details in Explorer). Included by
// wam.rc after it defines WAM_FILE_DESCRIPTION and WAM_FILE_NAME.

#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WAM_VERSION_MAJOR, WAM_VERSION_MINOR, WAM_VERSION_PATCH, 0
PRODUCTVERSION WAM_VERSION_MAJOR, WAM_VERSION_MINOR, WAM_VERSION_PATCH, 0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "davidsama"
            VALUE "FileDescription",  WAM_FILE_DESCRIPTION
            VALUE "FileVersion",      WAM_VERSION
            VALUE "InternalName",     WAM_FILE_NAME
            VALUE "LegalCopyright",   "Copyright (c) 2026 davidsama"
            VALUE "OriginalFilename", WAM_FILE_NAME
            VALUE "ProductName",      "wam - WoW Addon Manager"
            VALUE "ProductVersion",   WAM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
